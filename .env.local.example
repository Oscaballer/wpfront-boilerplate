# ==============================================================================
# WPFront Boilerplate - Environment Variables Example
# ==============================================================================

# ------------------------------------------------------------------------------
# WordPress Configuration
# ------------------------------------------------------------------------------
# WORDPRESS_URL: Used by the server for GraphQL queries (Secure, not exposed to browser)
# Example: https://mi-cms.com
WORDPRESS_URL=https://mi-cms.com

# NEXT_PUBLIC_WORDPRESS_URL: Only if you need the URL on the client (Avoid if possible)
NEXT_PUBLIC_WORDPRESS_URL=https://mi-cms.com

# Secret for on-demand revalidation (ISR) from WordPress
# Used in headers as: x-revalidate-secret
REVALIDATE_SECRET=generar_un_token_aleatorio_largo

# ------------------------------------------------------------------------------
# I18n / Multilingual Configuration
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_I18N: Enable or disable multilingual support (true/false)
NEXT_PUBLIC_ENABLE_I18N=false

# NEXT_PUBLIC_DEFAULT_LOCALE: Default language (e.g., es, en, pt)
NEXT_PUBLIC_DEFAULT_LOCALE=es

# NEXT_PUBLIC_SUPPORTED_LOCALES: Comma separated list of supported languages
NEXT_PUBLIC_SUPPORTED_LOCALES=es,en,pt

# ------------------------------------------------------------------------------
# Site Metadata / SEO & Branding
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_NAME: The name of your website
NEXT_PUBLIC_SITE_NAME="WPFront Boilerplate"

# NEXT_PUBLIC_SITE_SUB_NAME: Subtitle or tagline of your website
NEXT_PUBLIC_SITE_SUB_NAME="Headless WordPress Starter"

# NEXT_PUBLIC_SITE_LOGO: Path to the website logo (absolute URL or local asset)
# Leave blank to fallback to dynamic SVG icon in header/footer
NEXT_PUBLIC_SITE_LOGO=""

# NEXT_PUBLIC_SITE_DESCRIPTION: Default description for SEO
NEXT_PUBLIC_SITE_DESCRIPTION="A high-performance WordPress frontend built with Next.js"

# NEXT_PUBLIC_SITE_URL: The public URL of this frontend application
NEXT_PUBLIC_SITE_URL=https://mi-sitio.com

# ------------------------------------------------------------------------------
# Contact & Social Networks
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_PHONE_LABEL=""
NEXT_PUBLIC_CONTACT_EMAIL="contacto@mi-sitio.com"
NEXT_PUBLIC_CONTACT_LOCATION="Calle Principal 123, Ciudad, Pais"

NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""

# ------------------------------------------------------------------------------
# Algolia Configuration (Search)
# ------------------------------------------------------------------------------
# APP ID, Search Key and Index Name (exposed to frontend)
NEXT_PUBLIC_ALGOLIA_APP_ID=tu_app_id_aqui
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=tu_search_api_key_aqui
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=wp_searchable_posts

# ALGOLIA_ADMIN_API_KEY: Used for server-side indexing operations (KEEP SECRET)
ALGOLIA_ADMIN_API_KEY=tu_admin_api_key_aqui

# ------------------------------------------------------------------------------
# Google Cloud Storage (GCP) Bucket Configuration
# ------------------------------------------------------------------------------
# Configures the transparency portal file tree manager via public GCP bucket api
NEXT_PUBLIC_GCP_BUCKET_NAME=""
NEXT_PUBLIC_GCP_BUCKET_HOST=""

# ------------------------------------------------------------------------------
# Analytics & Tracking (Optional)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID: Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# Development & Debugging
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_DEBUG_MODE: Enable verbose logging (true/false)
NEXT_PUBLIC_DEBUG_MODE=false
